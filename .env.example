# Copy to .env and fill in real values (never commit .env)

# Database
DB_HOST=your-host:3306
DB_DATABASE=your_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Email (Gmail SMTP or Google Workspace)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=Your Company CRM

# Frontend URL for invitation links
FRONTEND_URL=http://localhost:3000

# Optional: The Bride Side auto-divert targets
TBS_BRIDESIDE_PIPELINE_ID=
TBS_BRIDESIDE_ORGANIZATION_ID=
TBS_BRIDESIDE_DEAL_CATEGORY_ID=
